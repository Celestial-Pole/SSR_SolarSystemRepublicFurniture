<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<!-- 模特(女) -->

	<ThingDef ParentName="SSR_BuildingBase_Furniture">
		<defName>SSR_Mannequin_Female</defName>
		<label>模特(女)</label>
		<description>模特(女)</description>
		<altitudeLayer>BuildingOnTop</altitudeLayer>
		<passability>PassThroughOnly</passability>
		<fillPercent>0.40</fillPercent>
		
		<statBases>
			<MaxHitPoints>200</MaxHitPoints>
			<WorkToBuild>2000</WorkToBuild>
			<Mass>15</Mass>
			<Flammability>1.0</Flammability>
			<Beauty>10</Beauty>
		</statBases>
		<costList>
			<Steel>50</Steel>
		</costList>
		<canOverlapZones>true</canOverlapZones>
		<pathCost>14</pathCost>
		<rotatable>true</rotatable>
		<size>(1,1)</size>
		<uiIconOffset>(0, 0.15)</uiIconOffset>
		<building>
			<destroySound>BuildingDestroyed_Soft_Medium</destroySound>
			<destroyShakeAmount>0</destroyShakeAmount>
		</building>
		<researchPrerequisites>
			<li>ComplexFurniture</li>
		</researchPrerequisites>
		<uiIconPath>Things/Building/Furniture/Mannequin/SSR_Mannequin_Female</uiIconPath>
		<graphicData>
			<drawSize>(2,2)</drawSize>
			<texPath>Things/Building/Furniture/Mannequin/SSR_Mannequin_Female</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawOffset>(0,0,0.5)</drawOffset>
		</graphicData>
		<defaultPlacingRot>South</defaultPlacingRot>
	</ThingDef>

